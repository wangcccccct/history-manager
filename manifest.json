{
  "manifest_version": 3,
  "name": "History Manager",
  "version": "1.0.0",
  "description": "Manage hidden browsing history with simple domain rules.",
  "action": {
    "default_title": "History Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-inactive.png",
      "48": "icons/icon-inactive.png",
      "128": "icons/icon-inactive.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "history", "tabs", "contextMenus"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-inactive.png",
    "48": "icons/icon-inactive.png",
    "128": "icons/icon-inactive.png"
  }
}
